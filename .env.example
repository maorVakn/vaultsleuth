# Copy to .env for local Docker Compose use. Do not commit real credentials.
GEMINI_API_KEY=
VAULT_TOKEN=dev-token
VAULT_DEV_PORT=8201

# Frontend dev server origins, comma-separated. Docker frontend calls the API
# directly from the browser through http://localhost:8000.
VAULTSLEUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
